<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LionFire.Blazor.Components.MudBlazor_</RootNamespace>
  	<Nullable>enable</Nullable>
  	<Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="wwwroot\LionFire.Blazor.Components.MudBlazor.css" />
  </ItemGroup>

  
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Radzen.Blazor" />
    <PackageReference Include="ReactiveUI.Blazor" />
    <PackageReference Include="ReactiveUI.SourceGenerators">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.ComponentModel" />
    <PackageReference Include="System.ComponentModel.Annotations" />
	  <PackageReference Include="ObservableCollections" />
	  <PackageReference Include="System.Reactive.Async" />
		<PackageReference Include="Microsoft.CodeAnalysis.Common" />
		<PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" />
	</ItemGroup>

  <ItemGroup>
    <!-- Lean tier: canonical InlineSelector + lean siblings (AutoRefreshButton,
         EnumerableViewComponent) now live here so MudBlazor-only consumers can take
         them without the heavy graph. Referenced back so this project stays single-
         source and its samples keep resolving LionFire.Blazor.Components.MudBlazor_. -->
    <ProjectReference Include="..\LionFire.Blazor.Components.MudBlazor.Lean\LionFire.Blazor.Components.MudBlazor.Lean.csproj" />
    <ProjectReference Include="..\LionFire.Base\LionFire.Base.csproj" />
    <ProjectReference Include="..\LionFire.Blazor.Components\LionFire.Blazor.Components.csproj" />
    <ProjectReference Include="..\LionFire.Data.Async.Abstractions\LionFire.Data.Async.Abstractions.csproj" />
    <ProjectReference Include="..\LionFire.Data.Async.Mvvm\LionFire.Data.Async.Mvvm.csproj" />
    <ProjectReference Include="..\LionFire.Data.Async.UI\LionFire.Data.Async.UI.csproj" />
    <ProjectReference Include="..\LionFire.Inspection\LionFire.Inspection.csproj" />
    <ProjectReference Include="..\LionFire.Mvvm\LionFire.Mvvm.csproj" />
    <ProjectReference Include="..\LionFire.Orleans.Structures.Abstractions\LionFire.Orleans.Structures.Abstractions.csproj" />
    <ProjectReference Include="..\LionFire.UI.Abstractions\LionFire.UI.Abstractions.csproj" />
    <ProjectReference Include="..\LionFire.UI.Entities\LionFire.UI.Entities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ObjectExplorer\" />
    <Folder Include="Pages\Account\" />
  </ItemGroup>

</Project>
